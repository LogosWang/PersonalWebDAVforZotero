#!/usr/bin/env python3
"""Manage accounts for the Zotero WebDAV share.

  davuser list                 list accounts
  davuser add NAME             create an account (asks for the password)
  davuser passwd NAME          change an account's password
  davuser del NAME             delete an account
  davuser unlock [NAME|all]    clear a lockout after too many wrong passwords
  davuser log [N]              show the last N login attempts (default 30)

Passwords are typed by the person at the keyboard (getpass); they are stored
only as salted PBKDF2-SHA256 hashes in users.json.
"""
import getpass
import hashlib
import json
import os
import platform
import re
import secrets
import subprocess
import sys
import time

CONF = os.path.dirname(os.path.realpath(__file__))
USERS = os.path.join(CONF, "users.json")
STATE = os.path.join(CONF, "authfail.json")
LOG = os.path.join(CONF, "auth.log")
SETTINGS = os.path.join(CONF, "config.json")
NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
ITERATIONS = 200000


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(path, data):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=1, ensure_ascii=False)
    os.replace(tmp, path)


def ask_password():
    while True:
        p1 = getpass.getpass("Password (at least 6 characters): ")
        if len(p1) < 6:
            print("Too short.")
            continue
        if p1 != getpass.getpass("Repeat: "):
            print("The two entries differ, try again.")
            continue
        return p1


def make_record(password):
    salt = secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, ITERATIONS)
    return {"salt": salt.hex(), "iter": ITERATIONS, "hash": digest.hex(),
            "updated": time.strftime("%Y-%m-%d %H:%M")}


def restart_server():
    # rclone caches successful logins; restarting drops them, so a deleted
    # account or an old password stops working immediately.
    label = load(SETTINGS).get("label", "")
    if platform.system() == "Darwin":
        cmd = ["launchctl", "kickstart", "-k", "gui/%d/%s" % (os.getuid(), label)]
    else:
        cmd = ["systemctl", "--user", "restart", label + ".service"]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def need_name(args):
    if len(args) < 2 or not NAME_RE.match(args[1]):
        sys.exit("Account names may use letters, digits and . _ - (max 32), e.g. davuser add alice")
    return args[1]


def main(args):
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = args[0]
    users = load(USERS)

    if cmd == "list":
        if not users:
            print("(no accounts yet)")
        for name, rec in sorted(users.items()):
            print("%-20s  password set %s" % (name, rec.get("updated", "?")))
    elif cmd == "add":
        name = need_name(args)
        if name in users:
            sys.exit("Account %s exists; to change its password: davuser passwd %s" % (name, name))
        users[name] = make_record(ask_password())
        save(USERS, users)
        print("Created %s (active immediately)." % name)
    elif cmd == "passwd":
        name = need_name(args)
        if name not in users:
            sys.exit("No account %s" % name)
        users[name] = make_record(ask_password())
        save(USERS, users)
        restart_server()
        print("Password of %s changed; the old one no longer works." % name)
    elif cmd == "del":
        name = need_name(args)
        if name not in users:
            sys.exit("No account %s" % name)
        del users[name]
        save(USERS, users)
        restart_server()
        print("Deleted %s." % name)
    elif cmd == "unlock":
        target = args[1] if len(args) > 1 else "all"
        state = load(STATE)
        if target == "all":
            state = {}
        else:
            state.pop("user:" + target, None)
        save(STATE, state)
        print("Unlocked: %s" % target)
    elif cmd == "log":
        n = int(args[1]) if len(args) > 1 else 30
        try:
            with open(LOG) as f:
                lines = f.readlines()[-n:]
        except OSError:
            lines = []
        sys.stdout.write("".join(lines) or "(no login attempts yet)\n")
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
